{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(terraform destroy *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(goose *)",
      "Bash(aws *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr create *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": ["git push *"],
    "filesystem": {
      "denyRead": [
        "./.env", "./**/.env", "./.env.*", "./**/.env.*", "./secrets",
        "./**/*.pem", "./**/*.key", "./**/*.p8", "./**/*.p12", "./**/*.pfx", "./**/*.jks", "./**/*.keystore",
        "./**/*.mobileprovision", "./**/key.properties", "./**/google-services.json",
        "./**/GoogleService-Info.plist", "./**/service-account*.json", "./**/id_rsa", "./**/id_ed25519",
        "~/**/.env", "~/**/.env.*",
        "~/.ssh", "~/.aws", "~/.gnupg", "~/.config/gh", "~/.config/gcloud", "~/.config/op",
        "~/.docker/config.json", "~/.kube", "~/.netrc", "~/.git-credentials", "~/.pgpass",
        "~/.vault-token", "~/.terraform.d/credentials.tfrc.json", "~/.pub-cache/credentials.json",
        "~/Library/Application Support/dart/pub-credentials.json", "~/Library/Keychains",
        "~/.config/git/credentials", "~/.gradle/gradle.properties", "~/.pypirc", "~/.yarnrc.yml",
        "~/.claude.json", "~/.zsh_history", "~/.bash_history"
      ],
      "allowRead": ["./.env.example", "./**/.env.example"],
      "denyWrite": [
        "./.claude", "./.mcp.json", "./.git/config", "./.git/config.worktree", "./.git/hooks",
        "./.git/commondir", "./.git/worktrees", "./.git/modules",
        "~/.pub-cache/bin", "~/.pub-cache/global_packages", "~/.pub-cache/git", "~/go/pkg/mod/cache/vcs"
      ],
      "allowWrite": [
        "~/Library/Caches/go-build", "~/go/pkg/mod", "~/Library/Caches/golangci-lint",
        "~/.npm", "~/Library/pnpm/store", "~/Library/Caches/pnpm", "~/.pub-cache"
      ]
    },
    "network": {
      "allowedDomains": [
        "proxy.golang.org", "sum.golang.org", "vuln.go.dev", "storage.googleapis.com",
        "api.osv.dev", "github.com", "api.github.com", "codeload.github.com", "*.githubusercontent.com",
        "registry.npmjs.org", "pub.dev", "registry.terraform.io", "releases.hashicorp.com"
      ]
    }
  }
}
